{
  "title": "Concert Loadtest - Overview",
  "schemaVersion": 38,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "tags": ["loadtest", "concert"],
  "timezone": "browser",
  "templating": { "list": [] },
  "annotations": {
    "list": [
      {
        "name": "Chaos Events",
        "datasource": "Prometheus",
        "enable": true,
        "expr": "changes(ALERTS{alertstate=\"firing\"}[1m])",
        "iconColor": "rgba(255, 96, 96, 1)",
        "titleFormat": "Chaos event",
        "textFormat": "{{alertname}}"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "QPS by endpoint",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (path) (rate(http_requests_total[30s]))",
          "legendFormat": "{{path}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Active k6 VUs",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "k6_vus",
          "legendFormat": "vus",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Error rate by status",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (status) (rate(http_requests_total{status=~\"4..|5..\"}[30s]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "HTTP latency percentiles",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_request_duration_seconds_bucket[1m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[1m])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket[1m])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "id": 5,
      "title": "RabbitMQ consumed rate",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 8, "h": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (queue, result) (rate(rabbitmq_consumed_total[30s]))",
          "legendFormat": "{{queue}} {{result}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "DLQ depth",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 16, "w": 8, "h": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rabbitmq_dlq_depth",
          "legendFormat": "{{queue}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Idempotency dedup hits",
      "type": "timeseries",
      "gridPos": { "x": 16, "y": 16, "w": 8, "h": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (consumer) (rate(idempotency_dedup_total[30s]))",
          "legendFormat": "{{consumer}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Trip accept lock contention",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 24, "w": 8, "h": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (result) (rate(trip_accept_lock_contention_total[30s]))",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Rate limit rejections",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 24, "w": 8, "h": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (endpoint) (rate(rate_limit_rejections_total[30s]))",
          "legendFormat": "{{endpoint}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "Bloom filter hits",
      "type": "timeseries",
      "gridPos": { "x": 16, "y": 24, "w": 8, "h": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (filter, result) (rate(bloom_filter_hits_total[30s]))",
          "legendFormat": "{{filter}} {{result}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "title": "Attacker blocked by Bloom (custom)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 32, "w": 8, "h": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(attacker_blocked_by_bloom[1m])",
          "legendFormat": "blocked rate",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "title": "Trip assigned within 15s (custom)",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 32, "w": 8, "h": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(trip_assigned_within_15s[1m])",
          "legendFormat": "assigned rate",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "title": "Pod restarts",
      "type": "timeseries",
      "gridPos": { "x": 16, "y": 32, "w": 8, "h": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "changes(kube_pod_container_status_restarts_total[5m])",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ]
    }
  ]
}
